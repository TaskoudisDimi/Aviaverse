JWT_SECRET=supersecretkey_minimum32characters_abc
GEMINI_API_KEY=AIza...

# Resend (https://resend.com) — used to send password-reset and upgrade-nudge
# emails. Leave blank to disable email sending (requests will be accepted but
# no email will actually go out — logged as a warning). The upgrade-nudge
# scheduler itself only starts when a Resend key is configured.
RESEND_API_KEY=re_...
EMAIL_FROM=VJet-Academy <onboarding@resend.dev>
EMAIL_REPLY_TO=
FRONTEND_URL=http://localhost:3000

# Google Sign-In OAuth Client ID (https://console.cloud.google.com/apis/credentials).
# Leave blank to disable Google login — email/password still works.
GOOGLE_CLIENT_ID=

# Stripe (https://dashboard.stripe.com/apikeys) — paid plan checkout/billing.
# Leave blank to disable paid checkout — free plan still works.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...