# Environment files — NEVER commit these
.env
.env.prod
.env.local

# Pre-built Linux binaries (built locally with build-prod.sh)
dist/

# Go build artifacts — `go build .` with no -o names the binary after the
# package dir, e.g. `services/auth/auth`, not `auth-service`.
services/auth/auth
services/content/content
services/ai/ai
services/exam/exam
services/progress/progress
services/gateway/gateway
services/ai/ingest
services/ai/query

# Frontend
frontend/node_modules/
frontend/dist/

# Logs
logs/
*.log

# Reference material (source PDFs/textbooks for authoring exam content) —
# large binary files, some copyrighted/third-party. Kept locally only, never
# committed. See db/migrations/ for the actual content derived from these.
Library/

# macOS
.DS_Store

# Temp
/tmp/vyron-pids
