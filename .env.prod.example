# ─── Aviaverse Academy — Production Environment ───────────────────────────────
# Copy this file to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod to git.

# JWT secret (strong random string — generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# Google Gemini API key (https://aistudio.google.com → API Keys)
GEMINI_API_KEY=AIza...

# PostgreSQL password (choose a strong one)
POSTGRES_PASSWORD=choose_a_strong_password_here

# Resend (https://resend.com → API Keys) — sends password-reset and
# upgrade-nudge emails (the upgrade-nudge scheduler only starts when this is
# set). EMAIL_FROM must use a domain verified in your Resend account (Domains
# tab), e.g. "VJet-Academy <noreply@yourdomain.com>". Without domain
# verification you can only send to your own Resend account email, which is
# fine for testing but not for real users.
RESEND_API_KEY=re_...
EMAIL_FROM=VJet-Academy <noreply@yourdomain.com>
EMAIL_REPLY_TO=

# Public URL of the frontend — used to build the link inside reset emails.
FRONTEND_URL=http://YOUR_SERVER_IP:3000

# Google Sign-In OAuth Client ID (https://console.cloud.google.com/apis/credentials
# → Web application client, Authorized JavaScript origins = your frontend URL).
# Leave blank to disable Google login — email/password still works. Note the
# frontend also needs its own copy as the VITE_GOOGLE_CLIENT_ID GitHub secret
# (build-time, see docs/deploy.md) — this is the backend's copy, used to
# verify Google ID tokens server-side.
GOOGLE_CLIENT_ID=

# Stripe (https://dashboard.stripe.com/apikeys) — paid plan checkout/billing.
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you configure in the
# Stripe dashboard pointing at /api/v1/auth/stripe/webhook. Leave both blank
# to disable paid checkout — the free plan still works.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
