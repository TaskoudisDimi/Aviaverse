# ─── Aviaverse Academy — Production Environment ───────────────────────────────
# Copy this file to .env.prod and fill in all values before deploying.
# NEVER commit .env.prod to git.

# JWT secret (strong random string — generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_OUTPUT_OF__openssl_rand_-hex_32

# Google Gemini API key (https://aistudio.google.com → API Keys)
GEMINI_API_KEY=AIza...

# PostgreSQL password (choose a strong one)
POSTGRES_PASSWORD=choose_a_strong_password_here

# Resend (https://resend.com → API Keys) — sends password-reset emails.
# EMAIL_FROM must use a domain verified in your Resend account (Domains tab),
# e.g. "VJet-Academy <noreply@yourdomain.com>". Without domain verification
# you can only send to your own Resend account email, which is fine for
# testing but not for real users.
RESEND_API_KEY=re_...
EMAIL_FROM=VJet-Academy <noreply@yourdomain.com>

# Public URL of the frontend — used to build the link inside reset emails.
FRONTEND_URL=http://YOUR_SERVER_IP:3000
